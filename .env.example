# Reference configuration. Export these values in the shell that starts
# the backend. Copying this file to .env alone does not load it automatically.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PLANNER_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120

# Final Ollama replies use the model stored on each Agent.
# Mock mode ignores model selection and makes no LLM HTTP requests.
# To enable the offline demo, export LLM_PROVIDER=mock before starting Uvicorn.
DATABASE_URL=sqlite:///./agentdesk.db
