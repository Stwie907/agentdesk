# Native backend: export values in the shell that starts Uvicorn.
# Native Uvicorn does not automatically load a root .env file.
# Docker Compose: a root .env supplies the variables mapped in docker-compose.yml.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PLANNER_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120
MEMORY_RETRIEVAL_MODE=keyword
OLLAMA_EMBEDDING_MODEL=embeddinggemma
MEMORY_EMBEDDING_TIMEOUT_SECONDS=60
MEMORY_SEMANTIC_MIN_SIMILARITY=0.35
DATABASE_URL=sqlite:///./agentdesk.db

# Container Ollama requests use this dedicated address instead of native localhost.
COMPOSE_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Final Ollama replies use the model stored on each Agent.
# Compose uses sqlite:////data/agentdesk.db in its named volume.
# The Mock override explicitly sets LLM_PROVIDER=mock for the demo.
# Native Mock mode: export LLM_PROVIDER=mock before starting Uvicorn.

# MCP SDK dependencies stay separate from the backend environment.
# Native backend auto-detects mcp-server/.venv; alternatively export MCP_PYTHON.
# MCP_PYTHON=/absolute/path/to/mcp-server/.venv/Scripts/python.exe
# The backend image supplies its own isolated MCP Python executable.
MCP_TIMEOUT_SECONDS=30
